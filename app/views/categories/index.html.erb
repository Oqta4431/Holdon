<div class="min-h-[70vh] bg-base-200/30">
  <div class="mx-auto w-full max-w-md px-4 py-6">

    <%= link_to @return_to || items_path, class: "btn btn-ghost btn-square" do %>
      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6" />
      </svg>
    <% end %>

    <h1 class="text-xl font-bold mt-4">カテゴリー管理</h1>

    <% if @categories.empty? %>
      <p class="mt-6 text-center text-base-content/60">カテゴリーがありません</p>
    <% else %>
      <ul class="mt-6 space-y-2">
        <% @categories.each do |category| %>
          <li class="flex items-center justify-between px-4 py-3 bg-base-100 rounded-box">
            <span><%= category.name %></span>

            <%# 削除前に確認ダイアログを表示する。削除後は紐づくItemのcategory_idがNULLになる %>
            <%= link_to category_path(category),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "「#{category.name}」を削除しますか？\n紐づく商品のカテゴリーは「なし」になります。"
                  },
                  class: "btn btn-ghost btn-sm text-error" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd"
                  d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z"
                  clip-rule="evenodd"
                />
              </svg>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>

  </div>
</div>
