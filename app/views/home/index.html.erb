<%# 金額カード（比率バーの上に配置） %>
<div class="w-full max-w-md mx-auto px-4 pt-3 flex gap-3">

  <%# 右：見送り金額（青系） %>
  <div class="flex-1 rounded-2xl px-4 py-3 bg-info/10">
    <p class="text-xs font-medium text-info/60 mb-1">見送り金額</p>
    <p class="text-xl font-bold text-info leading-none">
      ¥<%= number_with_delimiter(@skipped_price) %>
    </p>
  </div>

  <%# 左：購入金額（赤系） %>
  <div class="flex-1 rounded-2xl px-4 py-3 bg-error/10">
    <p class="text-xs font-medium text-error/60 mb-1">購入金額</p>
    <p class="text-xl font-bold text-error leading-none">
      ¥<%= number_with_delimiter(@purchased_price) %>
    </p>
  </div>

</div>

<!-- 金額比率バー -->
<%# 購入 vs 見送り 比率バー %>
<div class="w-full max-w-md mx-auto px-4 py-3">
  <% if @judged_price == 0 %>
    <%# アイテムが1件もない状態：グレーバー %>
    <div class="w-full h-3 rounded-full bg-base-300" role="progressbar" aria-label="データなし"></div>
    <div class="flex justify-between mt-2">
      <span class="text-xs text-base-content/40">見送り —</span>
      <span class="text-xs text-base-content/40">購入 —</span>
    </div>
  <% else %>
    <%# 比率バー %>
    <div class="w-full h-3 rounded-full overflow-hidden flex" role="progressbar" aria-label="購入 <%= @purchased_ratio %>% / 見送り <%= @skipped_ratio %>%">
      <div
        class="h-full bg-info transition-all duration-500"
        style="width: <%= @skipped_ratio %>%"
      ></div>
      <div
        class="h-full bg-error transition-all duration-500"
        style="width: <%= @purchased_ratio %>%"
      ></div>
    </div>
    <%# ラベル %>
    <div class="flex justify-between mt-2">
      <span class="text-xs font-medium text-info">
        見送り <%= @skipped_ratio %>%
      </span>
      <span class="text-xs font-medium text-error">
        購入 <%= @purchased_ratio %>%
      </span>
    </div>
  <% end %>
</div>


  <!-- 商品カード -->
  <% @yet_to_judge.each do |item| %>
  <li class="list-none">
    <%= link_to judgements_path, class: "block" do %>
      <div class="card bg-base-100 shadow-sm border">
        <div class="card-body p-3">
          <div class="flex gap-3 items-center">
            <!-- 仮画像 -->
            <div class="w-20 h-20 bg-gray-200 rounded-box flex items-center justify-center shrink-0">
              <% if item.item_image.attached? %>
                <%= image_tag item.item_image.variant(:thumb), class: "w-full h-full object-cover rounded-box" %>
              <% else %>
                <span class="text-sm text-base-content/60">画像</span>
              <% end %>
            </div>

            <div class="min-w-0">
              <div class="font-bold text-base leading-tight line-clamp-2">
                <%= item.name %>
              </div>

              <div class="mt-1 text-sm font-semibold">
                ¥ <%= number_with_delimiter(item.price) %>
              </div>
              <div class="mt-1 text-sm font-semibold">
                <% if item.reminder.remind_at < Time.current %>
                  今すぐ判定出来ます
                <% else %>
                  <%= distance_of_time_in_words_to_now(item.reminder.remind_at) %>後に判定予定
                <% end %>
              </div>
            </div>

          </div>
        </div>
      </div>
    <% end %>
  </li>
<% end %>
