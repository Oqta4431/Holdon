<div class="h-full">
  <div class="swiper w-full h-full">
    <div class="swiper-wrapper">

      <%# Slide 0: キャッチ %>
      <div class="swiper-slide">
        <div class="h-full flex flex-col items-center justify-center px-6 gap-6 pb-16">
          <div class="text-5xl font-extrabold text-primary tracking-tight">Holdon</div>
          <p class="text-center text-base text-base-content/70 leading-relaxed">衝動買いを、立ち止まって<br>考える習慣を。</p>
        </div>
      </div>

      <%# Slide 1: STEP 01 %>
      <div class="swiper-slide">
        <div class="h-full flex flex-col px-5 pt-4 pb-16">
          <div class="flex-1 flex items-center justify-center min-h-0">
            <div class="w-full h-full rounded-2xl bg-base-100 shadow-sm overflow-hidden">
              <%= image_tag "onboarding/Step1.png", class: "w-full h-full object-contain", alt: "商品登録画面" %>
            </div>
          </div>
          <div class="mt-4 text-center">
            <span class="badge badge-primary font-bold tracking-widest text-xs px-3">STEP 01</span>
            <h3 class="font-bold text-base mt-2 mb-1">「欲しい」を登録する</h3>
            <p class="text-xs text-base-content/60 leading-relaxed">気になった商品を見つけたらすぐに登録。URL・価格・メモも一緒に残せます。</p>
          </div>
        </div>
      </div>

      <%# Slide 2: STEP 02 %>
      <div class="swiper-slide">
        <div class="h-full flex flex-col px-5 pt-4 pb-16">
          <div class="flex-1 flex items-center justify-center min-h-0">
            <div class="w-full h-full rounded-2xl bg-base-100 shadow-sm overflow-hidden">
              <%= image_tag "onboarding/Step2.png", class: "w-full h-full object-contain", alt: "理由メモ画面" %>
            </div>
          </div>
          <div class="mt-4 text-center">
            <span class="badge badge-primary font-bold tracking-widest text-xs px-3">STEP 02</span>
            <h3 class="font-bold text-base mt-2 mb-1">理由を整理する</h3>
            <p class="text-xs text-base-content/60 leading-relaxed">買う理由・買わない理由を書き出してみよう。冷静に考えるきっかけになります。</p>
          </div>
        </div>
      </div>

      <%# Slide 3: STEP 03 %>
      <div class="swiper-slide">
        <div class="h-full flex flex-col px-5 pt-4 pb-16">
          <div class="flex-1 flex items-center justify-center min-h-0">
            <div class="w-full h-full rounded-2xl bg-base-100 shadow-sm overflow-hidden">
              <%= image_tag "onboarding/Step3.png", class: "w-full h-full object-contain", alt: "購入判断画面" %>
            </div>
          </div>
          <div class="mt-4 text-center">
            <span class="badge badge-primary font-bold tracking-widest text-xs px-3">STEP 03</span>
            <h3 class="font-bold text-base mt-2 mb-1">冷静に判断する</h3>
            <p class="text-xs text-base-content/60 leading-relaxed">「購入」「見送り」「再検討」の3択。時間をおいた分、納得感のある選択ができます。</p>
          </div>
        </div>
      </div>

      <%# Slide 4: STEP 04 %>
      <div class="swiper-slide">
        <div class="h-full flex flex-col px-5 pt-4 pb-16">
          <div class="flex-1 flex items-center justify-center min-h-0">
            <div class="w-full h-full rounded-2xl bg-base-100 shadow-sm overflow-hidden">
              <%= image_tag "onboarding/Step4.png", class: "w-full h-full object-contain", alt: "振り返り画面" %>
            </div>
          </div>
          <div class="mt-4 text-center">
            <span class="badge badge-primary font-bold tracking-widest text-xs px-3">STEP 04</span>
            <h3 class="font-bold text-base mt-2 mb-1">振り返る</h3>
            <p class="text-xs text-base-content/60 leading-relaxed">判断の履歴を振り返り、自分の購買パターンへの理解を深めましょう。</p>
          </div>
        </div>
      </div>

      <%# Slide 5: CTA %>
      <div class="swiper-slide" data-turbo="false">
        <div class="h-full flex flex-col justify-center px-6 gap-6 pb-16">
          <div class="text-center">
            <h2 class="font-bold text-lg mb-2">判断のタイミングをお知らせします</h2>
            <p class="text-sm text-base-content/60 leading-relaxed">登録した商品の判断時間になったら<br>LINEで通知が届きます。</p>
          </div>

          <div class="flex flex-col items-center gap-3">
            <span class="badge badge-primary font-bold tracking-widest text-xs px-3">STEP 1</span>
            <div class="flex justify-center w-full">
              <div class="line-it-button" data-lang="ja" data-type="friend" data-env="PROD" data-lineId="@559mmzug" style="display: none;"></div>
            </div>
            <script src="https://www.line-website.com/social-plugins/js/thirdparty/loader.min.js" async="async" defer="defer" data-turbo-eval="false"></script>
          </div>

          <div class="divider my-0"></div>

          <div class="flex flex-col items-center gap-3">
            <span class="badge badge-primary font-bold tracking-widest text-xs px-3">STEP 2</span>
            <p class="text-sm font-medium">さっそく始めましょう</p>
            <div class="w-44 [&_form]:w-full [&_button]:w-full [&_img]:w-full">
              <%= render "devise/shared/links" %>
            </div>
          </div>
        </div>
      </div>

    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</div>

<style>
  .swiper-pagination-bullet {
    background: var(--color-base-content);
    opacity: 0.2;
  }
  .swiper-pagination-bullet-active {
    background: var(--color-primary) !important;
    opacity: 1 !important;
  }
  .swiper-button-prev,
  .swiper-button-next {
    --swiper-navigation-size: 16px;
    width: 28px;
    height: 28px;
    color: var(--color-base-content);
    opacity: 0.4;
  }
  .swiper-button-disabled {
    display: none !important;
  }
</style>

<script>
  new Swiper('.swiper', {
    loop: false,
    speed: 500,
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
  });
</script>
